---
import '../styles/global.css';
import Motion from '../components/Motion.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kavita Tewari — Product Designer' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafcfd" />
    <title>{title}</title>
    <Motion />
  </head>
  <body>
    <slot />
  </body>
</html>
