---
import '../styles/global.css';
import Motion from '../components/Motion.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kavita Tewari — Product Designer' } = Astro.props;

// Microsoft Clarity (session recordings, heatmaps, scroll depth). Production only,
// so local previews don't pollute the data.
const clarity = `(function(c,l,a,r,i,t,y){
  c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
  t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
  y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "zj91m97dd7");`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafcfd" />
    <title>{title}</title>
    <Motion />
    {import.meta.env.PROD && <script is:inline set:html={clarity} />}
  </head>
  <body>
    <slot />
  </body>
</html>
