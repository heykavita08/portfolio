---
// Figma "Diagram: CDSCO risk ladder" (231:590), rebuilt as live HTML so the
// source links work. Desktop reproduces the Figma coordinates exactly;
// phones get a stacked version of the same content.
const steps = [
  { cx: 92, top: 108, size: 60, msize: 52, fill: '#eb4604', ink: '#fff', tag: 'PeakPause', risk: 'Not a device', label: 'Records only', title: 'Usually exempt', desc: 'Stores and shows reports. No clinical advice.' },
  { cx: 240, top: 112, size: 80, msize: 60, fill: 'rgba(153, 165, 125, 0.35)', ink: '#171614', risk: 'Low to moderate risk', label: 'Class B', title: '3–6 months', desc: 'Flags abnormalities or summarises a report for a doctor.' },
  { cx: 408, top: 88, size: 104, msize: 68, fill: 'rgba(153, 165, 125, 0.6)', ink: '#171614', risk: 'Moderate to high risk', label: 'Class C', title: '6–12 months', desc: 'Diagnoses or suggests treatment, like AI reading a report.' },
  { cx: 596, top: 64, size: 128, msize: 76, fill: '#171614', ink: '#fff', risk: 'High risk', label: 'Class D', title: '6–12 months', desc: 'The same, for critical conditions: ICU, cancer, acute cardiac.' },
];

const notes = [
  { x: 40.5, title: 'Queries stop the clock', body: 'Official review is 45–120 days (domestic) and up to 270 days for imports. For diagnostic software, reviewers almost always send queries, and the clock stops until you reply.' },
  { x: 362.5, title: 'AI or ML adds a step', body: 'A suggestion engine built on AI or ML needs an Algorithm Change Protocol, which routinely pushes timelines to 6–12 months.' },
];

const sources = [
  { label: 'CDSCO public notices', href: 'https://cdsco.gov.in/opencms/resources/UploadCDSCOWeb/2018/UploadPublic_NoticesFiles/timeline.pdf' },
  { label: 'AsiaActual', href: 'https://asiaactual.com/blog/india-medical-device-software-guidance/' },
  { label: 'Freyr Solutions', href: 'https://www.freyrsolutions.com/blog/samd-regulation-in-india-cdsco-classification-class-a-d-registration-requirements-emerging-market-strategy' },
  { label: 'CliniExperts', href: 'https://cliniexperts.com/cdsco-registration-timeline-how-long-does-it-take-for-medical-devices/' },
  { label: 'Diligence Certification', href: 'https://www.diligencecertification.com/cdsco-rules-for-software-as-medical/' },
];

interface Props { class?: string }
const { class: className } = Astro.props;
---
<figure class:list={['ladder', className]} aria-label="CDSCO risk classes for health software, and how long a licence takes">
  <ol class="steps" data-stagger>
    {steps.map((s) => (
      <li class="step" style={`--cx:${s.cx}px;--top:${s.top}px;--size:${s.size}px;--msize:${s.msize}px;--fill:${s.fill};--ink:${s.ink}`}>
        {s.tag && <span class="tag">{s.tag}</span>}
        <span class="risk">{s.risk}</span>
        <span class="circle" aria-hidden="true"><span>{s.label}</span></span>
        <span class="visually-hidden">{s.label}:</span>
        <span class="title">{s.title}</span>
        <span class="desc">{s.desc}</span>
      </li>
    ))}
  </ol>
  <ul class="notes" data-stagger>
    {notes.map((n) => (
      <li class="note" style={`--x:${n.x}px`}>
        <span class="note-title">{n.title}</span>
        <span class="note-body">{n.body}</span>
      </li>
    ))}
  </ul>
  <p class="sources" data-reveal>
    Sources: {sources.map((s, i) => (
      <>{i > 0 && ', '}<a href={s.href} target="_blank" rel="noopener">{s.label}</a></>
    ))}
  </p>
</figure>

<style>
  .ladder {
    --soft: rgba(40, 39, 35, 0.6);
    --mid: rgba(40, 39, 35, 0.72);
    --dark: #171614;
    position: relative;
    width: 704px;
    max-width: 100%;
    height: 494px;
    margin-inline: 0;
    margin-bottom: 0;
  }

  /* ---------- Desktop: Figma coordinates ---------- */
  .steps { position: absolute; inset: 0; }
  .step {
    position: absolute;
    top: var(--top);
    left: calc(var(--cx) - 75px);
    width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .tag {
    align-self: center;
    margin-bottom: 7px;
    padding: 3px 8px;
    font-size: 9px;
    line-height: 11px;
  }
  .risk {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 8.5px;
    line-height: 11px;
    text-transform: uppercase;
    color: var(--soft);
  }
  .circle {
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    margin-top: 9px;
    border-radius: 50%;
    background: var(--fill);
    color: var(--ink);
    font-weight: 500;
    font-size: 10.5px;
    line-height: 12px;
  }
  .circle span { max-width: 54px; text-align: center; }
  .title {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 23px;
    color: var(--dark);
  }
  .desc {
    width: 140px;
    margin-top: 5px;
    font-size: 10px;
    line-height: 14px;
    color: var(--mid);
  }

  .notes { position: absolute; inset: 0; pointer-events: none; }
  .note {
    position: absolute;
    top: 358px;
    left: calc(var(--x) + 13.5px);
    width: 288px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .note::before {
    content: '';
    position: absolute;
    top: 4.5px;
    left: -13.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .note-title { font-weight: 500; font-size: 10.5px; line-height: 14px; color: var(--dark); white-space: nowrap; }
  .note-body { font-size: 9.5px; line-height: 13px; color: var(--mid); }

  .sources {
    position: absolute;
    top: 426px;
    left: 41px;
    font-size: 8px;
    line-height: 10px;
    color: var(--soft);
    white-space: nowrap;
  }
  .sources a { text-decoration: underline; text-underline-position: from-font; }
  .sources a:hover { color: var(--dark); }

  /* ---------- Phones: stacked ---------- */
  @media (max-width: 759px) {
    .ladder { height: auto; }
    .steps, .notes { position: static; }
    .steps { display: flex; flex-direction: column; border-top: 1px solid var(--line-soft); }
    .step {
      position: static;
      width: auto;
      display: grid;
      grid-template-columns: 84px 1fr;
      grid-template-areas: 'circle tag' 'circle risk' 'circle title' 'circle desc';
      grid-template-rows: auto auto auto 1fr;
      align-items: start;
      justify-items: start;
      text-align: left;
      column-gap: 16px;
      padding: 20px 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .tag { grid-area: tag; align-self: start; margin-bottom: 8px; }
    .risk { grid-area: risk; font-size: 10px; line-height: 14px; }
    .circle { grid-area: circle; justify-self: center; align-self: center; width: var(--msize); height: var(--msize); margin: 0; font-size: 10px; }
    .circle span { max-width: 44px; }
    .title { grid-area: title; margin-top: 4px; font-size: 21px; line-height: 26px; }
    .desc { grid-area: desc; width: auto; margin-top: 4px; font-size: 13px; line-height: 19px; }

    .notes { display: flex; flex-direction: column; gap: 20px; margin-top: 28px; pointer-events: auto; }
    .note { position: relative; top: auto; left: auto; width: auto; padding-left: 18px; }
    .note::before { left: 0; top: 6px; }
    .note-title { font-size: 14px; line-height: 19px; white-space: normal; }
    .note-body { font-size: 13px; line-height: 19px; }

    .sources { position: static; margin-top: 24px; font-size: 11px; line-height: 17px; white-space: normal; }
  }
</style>
