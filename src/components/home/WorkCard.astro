---
// A work card from the home page grid (Figma "Link" frames under "Detailed case studies" / "More work...").
// Media is laid out in Figma px: the poster is the exported thumbnail, a video (optional) sits at its
// exact rectangle, and overlays (slot "overlay") are positioned with the same units.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VideoSlot from '../case-study/VideoSlot.astro';
import type { AiTool } from '../../data/ai-tools';

interface Rect { x: number; y: number; w: number; h: number; r?: number }
interface Props {
  title: string;
  meta?: string;
  alt: string;
  /** Media size in Figma px (including the 1px border when the card has one). */
  w: number;
  h: number;
  poster?: ImageMetadata;
  video?: string;
  rect?: Rect;
  /** Inner box the video is clipped to (bordered cards keep their border visible). */
  clip?: Rect;
  rotate?: number;
  /** Custom media (no poster): background colour and optional 1px border. */
  bg?: string;
  border?: boolean;
  href?: string;
  /** Opens `embed` in the on-page dialog instead of leaving the site; `href` is the no-JS fallback (new tab). */
  popup?: { href: string; embed: string };
  /** Caption still to be written: shows a visible placeholder. */
  todo?: boolean;
  /** AI was part of the design and prototyping: shows a small tag on the media. */
  ai?: boolean;
  /** AI tools used on the project: small logos beside the title. */
  tools?: AiTool[];
}

const { title, meta, alt, w, h, poster, video, rect, clip, rotate, bg, border, href, popup, todo, ai, tools } = Astro.props;
const AI_TAG = 'Designed & prototyped with AI';
const Tag = href || popup ? 'a' : 'div';
// A popup link still works without JS (new tab); with JS it opens in the on-page dialog.
const tagProps = href
  ? { href }
  : popup
    ? { href: popup.href, target: '_blank', rel: 'noopener', 'data-embed': popup.embed, 'data-embed-title': title, 'aria-haspopup': 'dialog' }
    : {};
const hasOverlay = Astro.slots.has('overlay');
---
<Tag class:list={['card', { 'is-link': href || popup, 'is-todo': todo }]} style={`--W:${w};--mw:${w}px;--mratio:${w}/${h}`} {...tagProps}>
  {video && poster && rect ? (
    <VideoSlot class="card-media" poster={poster} alt={alt} src={video} width={w} height={h} rect={rect} clip={clip} rotate={rotate}>
      {hasOverlay && <slot name="overlay" />}
      {ai && <span class="ai-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C12.9 7.2 16.8 11.1 24 12C16.8 12.9 12.9 16.8 12 24C11.1 16.8 7.2 12.9 0 12C7.2 11.1 11.1 7.2 12 0Z" /></svg>{AI_TAG}</span>}
    </VideoSlot>
  ) : poster ? (
    <div class="card-media cbox">
      <Image class="cposter" src={poster} alt={alt} width={w} height={h} densities={[1, 2]} format="webp" quality={88} loading="lazy" />
      {hasOverlay && <slot name="overlay" />}
      {ai && <span class="ai-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C12.9 7.2 16.8 11.1 24 12C16.8 12.9 12.9 16.8 12 24C11.1 16.8 7.2 12.9 0 12C7.2 11.1 11.1 7.2 12 0Z" /></svg>{AI_TAG}</span>}
    </div>
  ) : (
    <div class:list={['card-media', 'cbox', { bordered: border }]} style={bg ? `--fill:${bg}` : undefined} role="img" aria-label={ai ? `${alt}. ${AI_TAG}` : alt}>
      <slot name="overlay" />
      {ai && <span class="ai-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C12.9 7.2 16.8 11.1 24 12C16.8 12.9 12.9 16.8 12 24C11.1 16.8 7.2 12.9 0 12C7.2 11.1 11.1 7.2 12 0Z" /></svg>{AI_TAG}</span>}
    </div>
  )}
  <span class:list={['cap', { 'has-tools': tools }]}>
    <span class="heading">
      <span class="title">{title}</span>
      {meta && <span class="meta">{meta}</span>}
    </span>
    {tools && (
      <span class="tools" role="list" aria-label="AI tools used">
        {tools.map((t) => (
          <span class:list={['tool', { tile: t.tile }]} role="listitem" data-name={t.name}>
            <img src={t.logo.src} alt={t.name} width="28" height="28" loading="lazy" decoding="async" />
          </span>
        ))}
      </span>
    )}
  </span>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    container: card / inline-size;
  }
  .card :global(.card-media) { width: min(var(--mw), 100%); }

  /* Barely rounded media with a faint hairline drawn on top, so posters with a baked-in Figma border
     don't show clipped corners. */
  .card { --radius: 2px; }
  .card :global(.card-media),
  .card :global(.vmedia),
  .cbox { border-radius: var(--radius); }
  .card :global(.vmedia) { isolation: isolate; }
  .card :global(.vmedia)::after,
  .cbox::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(50, 64, 79, 0.08);
    pointer-events: none;
  }
  .cbox {
    position: relative;
    aspect-ratio: var(--mratio);
    overflow: hidden;
    container-type: inline-size;
  }
  .cbox { background: var(--fill, transparent); }
  /* Figma "Border": a 1px tint over the page, the fill sits inside it (positions stay in outer px). */
  .cbox.bordered {
    background: linear-gradient(var(--fill), var(--fill)) center / calc(100% - 2px) calc(100% - 2px) no-repeat, var(--bg);
    box-shadow: inset 0 0 0 1px rgba(50, 64, 79, 0.1);
  }
  .cposter { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .ai-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 8px;
    border-radius: 999px;
    background: rgba(250, 252, 253, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 3px rgba(30, 43, 58, 0.12);
    color: #1e2b3a;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }
  .ai-tag svg { flex: none; width: 9px; height: 9px; fill: currentColor; }

  .cap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 4px;
  }
  /* Cards with tool logos: title over meta (if any) on the left, logos on the right. */
  .heading { display: contents; }
  .has-tools { align-items: center; }
  .has-tools .heading { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .tools { position: relative; z-index: 7; display: inline-flex; flex: none; gap: 6px; }
  /* Each logo sits on a small chip, so plain marks and full-colour app icons read as one set. */
  .tool {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(50, 64, 79, 0.12);
    transition: transform 0.2s var(--ease-out, ease);
  }
  .tool img { display: block; width: 20px; height: 20px; }
  .tool.tile { box-shadow: none; }
  .tool.tile img { width: 100%; height: 100%; border-radius: inherit; }
  .tool:hover { transform: translateY(-2px); }
  /* Tool name on hover. */
  .tool::after {
    content: attr(data-name);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 3px 7px;
    border-radius: 4px;
    background: #1e2b3a;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 3px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .tool:hover::after { opacity: 1; transform: translate(-50%, 0); }
  .title {
    font-family: var(--font-inter);
    font-size: 17px;
    line-height: 26px;
    letter-spacing: -0.34px;
    color: var(--ink);
    white-space: nowrap;
  }
  .meta {
    margin-top: -0.75px;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 22.5px;
    text-transform: uppercase;
    color: rgba(50, 64, 79, 0.58);
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  /* Hover: the media lifts a little on a soft shadow (no underline). */
  .card.is-link :global(.card-media) {
    transition: transform 0.5s var(--ease-out, ease), box-shadow 0.5s var(--ease-out, ease);
  }
  .card.is-link:hover :global(.card-media),
  .card.is-link:focus-visible :global(.card-media) {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -20px rgba(30, 43, 58, 0.4), 0 6px 14px -8px rgba(30, 43, 58, 0.14);
  }
  .card.is-link:hover .cbox.bordered,
  .card.is-link:focus-visible .cbox.bordered {
    box-shadow: inset 0 0 0 1px rgba(50, 64, 79, 0.1), 0 18px 36px -20px rgba(30, 43, 58, 0.4), 0 6px 14px -8px rgba(30, 43, 58, 0.14);
  }
  .card.is-link:hover .meta { color: var(--ink); }
  .card.is-todo .title, .card.is-todo .meta { color: #c8102e; }

  /* Overlay layers, in Figma px of the media box. */
  .card :global(.ov) {
    position: absolute;
    left: calc(var(--x) * 100cqw / var(--W));
    top: calc(var(--y) * 100cqw / var(--W));
    width: calc(var(--w) * 100cqw / var(--W));
    height: calc(var(--h) * 100cqw / var(--W));
    pointer-events: none;
  }

  /* Narrow cards (tablet two-up, phones): title over meta. */
  @container card (max-width: 540px) {
    .cap:not(.has-tools) { flex-direction: column; gap: 0; }
    /* A long title with many logos would squeeze to three lines: the logos drop to their own row instead. */
    .has-tools { align-items: flex-start; flex-wrap: wrap; gap: 8px 16px; }
    .title { white-space: normal; font-size: 16px; line-height: 23px; }
    .meta { margin-top: 2px; font-size: 13px; line-height: 20px; }
  }
</style>
