---
// Opens external work (a Figma deck, a Behance project) in an on-page dialog, so visitors never leave
// the site (Figma annotation). Any link with data-embed opens it; without JS the link opens in a new tab.
---
<dialog class="deck" aria-label="Presentation">
  <button class="deck-close" type="button" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </button>
  <div class="deck-frame"><iframe title="Presentation" allowfullscreen></iframe></div>
</dialog>

<style>
  .deck {
    width: min(1280px, calc(100vw - 48px));
    max-width: none;
    height: min(800px, calc(100dvh - 48px));
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: #121214;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(26, 36, 51, 0.35);
  }
  .deck::backdrop { background: rgba(18, 18, 20, 0.6); backdrop-filter: blur(6px); }
  .deck[open] { animation: deck-in 0.45s var(--ease-out, ease) both; }
  @keyframes deck-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } }
  .deck-frame, .deck iframe { width: 100%; height: 100%; border: 0; display: block; }
  .deck-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    backdrop-filter: blur(8px);
    transition: background 0.2s ease, transform 0.3s var(--ease-out, ease);
  }
  .deck-close:hover { background: rgba(255, 255, 255, 0.24); transform: scale(1.06); }
  @media (max-width: 600px) {
    .deck { width: 100vw; height: 100dvh; border-radius: 0; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.deck')!;
  const frame = dialog.querySelector('iframe')!;
  const close = () => dialog.close();
  dialog.querySelector('.deck-close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog.addEventListener('close', () => { frame.src = 'about:blank'; });

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-embed]')) {
    link.addEventListener('click', (e) => {
      if (typeof dialog.showModal !== 'function') return; // old browsers: follow the link
      e.preventDefault();
      const title = link.dataset.embedTitle || 'Project';
      dialog.setAttribute('aria-label', title);
      frame.title = title;
      frame.src = link.dataset.embed!;
      dialog.showModal();
    });
  }
</script>
