---
// Top bar shared by every page. Figma: "Nav" (196:314).
---
<header class="nav">
  <a class="brand" href="/">
    <span class="name">Kavita Tewari</span>
    <span class="role">Product Designer</span>
  </a>
  <nav class="links" aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/about">About</a>
    <a href="/resume.pdf">Resume</a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px 32px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .brand { display: flex; gap: 12px; }
  .name { color: var(--ink); }
  .role { color: var(--muted); }
  .links { display: flex; gap: 36px; color: var(--muted); }
  .links a, .name {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 0.2s ease, background-size 0.45s var(--ease-out);
  }
  .links a:hover, .brand:hover .name { color: var(--ink); background-size: 100% 1px; }
  :global(.motion) .nav { animation: nav-in 0.9s var(--ease-out) both; }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-6px); } }

  @media (max-width: 600px) {
    .nav { padding: 20px 16px; }
    .role { display: none; }
    .links { gap: 20px; }
  }
</style>
