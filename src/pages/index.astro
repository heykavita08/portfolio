---
// Home. Source: Figma "1920w light" (633:8850), Cooktop App file.
// Layout follows the Figma 1920 frame, set on the site's shared column (as on About): centred,
// 1200px max, at least 60px gutters, split in two with a 24px gap.
// Card captions: the Figma file carried template text from another portfolio; these are
// Kavita's projects, matched to each visual; titles from her Figma update, meta lines from her timeline.
import Base from '../layouts/Base.astro';
import WorkCard from '../components/home/WorkCard.astro';
import DeckDialog from '../components/home/DeckDialog.astro';
import TiltMark from '../components/home/TiltMark.astro';
import HomeNav from '../components/home/HomeNav.astro';
import Mascot from '../components/home/Mascot.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import whirlpoolLogo from '../assets/home/cards/whirlpool-logo.png';
import pinMask from '../assets/home/cards/pin-mask.png';
import caseCooktop from '../assets/home/cards/case-cooktop.png';
import caseVeyra from '../assets/home/cards/case-veyra.png';
import casePeakpause from '../assets/home/cards/case-peakpause.png';
import caseJb from '../assets/home/cards/case-jb.png';
import l1 from '../assets/home/cards/more-l1.png';
import l2 from '../assets/home/cards/more-l2.png';
import l3 from '../assets/home/cards/more-l3.png';
import l4 from '../assets/home/cards/more-l4.png';
import l5 from '../assets/home/cards/more-l5.png';
import l6 from '../assets/home/cards/more-l6.png';
import l7 from '../assets/home/cards/more-l7.png';
import r2 from '../assets/home/cards/more-r2.png';
import r3 from '../assets/home/cards/more-r3.png';
import r4 from '../assets/home/cards/more-r4.png';
import r6 from '../assets/home/cards/more-r6.png';
import r7 from '../assets/home/cards/more-r7.png';
import r7Phone from '../assets/home/cards/more-r7-phone.png';
import r7Grips from '../assets/home/cards/more-r7-grips.png';

const DECK_URL = 'https://www.figma.com/deck/mRsFPUIQRjeqk4KO44klcB';
const MAPS_POPUP = { href: DECK_URL, embed: `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(DECK_URL)}` };
// Behance blocks its normal page in frames; its official embed URL is allowed.
const YUCATAN_POPUP = {
  href: 'https://www.behance.net/gallery/234823285/Yucatan-UIUX-CGI-Website',
  embed: 'https://www.behance.net/embed/project/234823285?ilo0=1',
};

const timeline = [
  ['2026', 'VEYRA', 'Pet tracker app + wearable · Design lead (ongoing)'],
  ['2026', 'Reborn Goods', 'Platform · UX lead'],
  ['2026', 'JB Air', 'HMI & Website Design · Spec definition'],
  ['2026', 'Identity Labs', 'Agency website · Design lead'],
  ['2026', 'HUM US', 'Food brand · Website + Shopify build'],
  ['2025', 'PeakPause', 'Health records app · Research + core design'],
  ['2025', 'i3000 NAR', 'Cooktop app · Spec definition'],
  ['2025', 'i3000 EMEA', 'Cooktop app · Spec definition'],
  ['2025', 'LPP OPP', 'Microwave · Spec definition'],
  ['2025', 'Keurig i200', 'Coffee machine · Spec management'],
  ['2024', 'ORION', 'eVTOL dashboard · Tablet system design'],
  ['2024', 'Trimkit MHC DOE', 'Microwave · Spec definition'],
  ['2024', 'QC+ Induction', 'Induction · App & HMI'],
  ['2024', 'Keurig', 'Coffee machine · Spec management, team of 6'],
  ['2024', 'Rubicon', 'Washing machine · Spec conversion'],
  ['2023', 'Yucatan', 'Platform design'],
  ['2023', 'A330 Q+ Phase 2 Study', 'Oven · Spec definition'],
  ['2023', 'A330 Q+ Phase 2', 'Oven · Study prototypes'],
  ['2023', 'Titan 4', 'Microwave · Spec definition'],
  ['2022-23', 'QC+ Induction Study', 'Induction · Study prototypes'],
  ['2022', 'Big 6 Prototypes', 'Ovens, all brands · Prototyping'],
  ['2022', 'Flush / QC+ Phase 1', 'Microwave + oven · Spec definition'],
  ['2022', 'Scribble T', 'Website · POD'],
];

const skills = [
  ['UI/UX Design', 'Craft'],
  ['AI fluency and workflow automation', 'Process'],
  ['Functional prototyping', 'Craft'],
  ['Strategic problem framing and business thinking', 'Strategy'],
  ['Systems thinking', 'Strategy'],
  ['No-code development', 'Craft'],
  ['Human Machine Interface Design', 'Craft'],
];

---
<Base title="Kavita Tewari — Product Designer" description="Kavita Tewari, product designer: apps, websites, tablets and appliance screens.">
  <!-- Background+HorizontalBorder (633:9202) -->
  <HomeNav href="/about" label="About & contact" />

  <main class="home" id="top">
    <!-- Card / Front (633:9216): embossed wordmark -->
    <TiltMark />

    <!-- Intro (633:8860) -->
    <section class="intro">
      <div class="intro-left">
        <p class="intro-lede" data-split>Not every design problem comes in a Figma-sized box.</p>
        <dl class="intro-details" data-stagger>
          <div>
            <dt>Experience</dt>
            <dd class="dd-strong">5+ years</dd>
          </div>
          <div>
            <dt>Areas I work across</dt>
            <dd>Product strategy · UX research · Interaction design · UI design · Prototyping · No-code development</dd>
          </div>
          <div>
            <dt>Products &amp; environments</dt>
            <dd>Mobile · Web · Tablet · Connected appliances · Early-stage startups · Enterprise</dd>
          </div>
        </dl>
      </div>
      <ol class="timeline tl-desk" data-stagger aria-label="Projects">
        {timeline.map(([year, name, desc]) => (
          <li class="row">
            <span class="row-year">{year}</span>
            <span class="row-name">{name}</span>
            <span class="row-desc">{desc}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Detailed case studies (633:9050 + 633:9054) -->
    <section class="block" id="work" aria-labelledby="h-case">
      <h2 class="h-sec h-case" id="h-case" data-split>Detailed case studies</h2>
      <div class="grid grid-case">
        <div class="col col-l" data-stagger>
          <WorkCard
            title="Two markets, one cooktop app" meta="Whirlpool i3000 • Shipped 2025" href="/work/cooktop"
            alt="Whirlpool logo over the cooktop app" poster={caseCooktop} w={888} h={547}
            video="/videos/home/cooktop.mp4" rect={{ x: 114.5, y: -178.74, w: 659, h: 978.468 }} rotate={90}
            clip={{ x: 1, y: 1, w: 886, h: 545 }}
          >
            <span slot="overlay" class="ov ov-logo" style="--x:208;--y:193;--w:472.843;--h:161.762">
              <Image src={whirlpoolLogo} alt="" width={473} densities={[1, 2]} format="webp" quality={90} loading="lazy" />
            </span>
          </WorkCard>
          <WorkCard
            title="Pet tracker app + wearable" meta="VEYRA • Ongoing 2026" href="/work/veyra"
            alt="VEYRA app home: Champa is home" poster={caseVeyra} w={886} h={497.5}
            video="/videos/home/veyra.mp4" rect={{ x: 337, y: 124.32, w: 211, h: 444, r: 41 }}
          />
        </div>
        <div class="col col-r" data-stagger>
          <WorkCard
            title="Health records people actually keep" meta="PeakPause • Shipped 2025" href="/work/peakpause"
            alt="PeakPause app: your timeline and health summary" poster={casePeakpause} w={888} h={499.5}
            video="/videos/home/peakpause.mp4" rect={{ x: 350.66, y: 54.24, w: 186.682, h: 391.023, r: 35.318 }}
          />
          <WorkCard
            title="One design language, screen to site" meta="JB Air • Shipped 2026" href="/work/jb-air"
            alt="The JB Air purifier in a living room" poster={caseJb} w={888} h={555}
            video="/videos/home/jb.mp4" rect={{ x: -8, y: -43.6, w: 904, h: 603 }} clip={{ x: 1, y: 1, w: 886, h: 553 }}
          />
        </div>
      </div>
    </section>

    <!-- More work (633:9100 + 633:9104) -->
    <section class="block" aria-labelledby="h-more">
      <h2 class="h-sec h-more" id="h-more" data-split>More work...</h2>
      <div class="grid grid-more">
        <div class="col col-l" data-stagger>
          <WorkCard
            title="Coffee machine spec management" meta="Keurig i200 • 2025"
            alt="Keurig alta screen in an oval frame over clouds" poster={l1} w={886} h={497.5}
            video="/videos/home/l1.mp4" rect={{ x: 310, y: 26.005, w: 266, h: 444, r: 136 }}
          />
          <WorkCard
            title="eVTOL dashboard, tablet system design" meta="ORION • 2024"
            alt="ORION eVTOL management and details screens on two iPads" poster={l2} w={888} h={555}
          />
          <WorkCard
            title="Yucatan web explorations" meta="Yucatan • Concept 2023"
            alt="A 3D carousel of fashion editorial pages" poster={l3} w={886} h={497.5}
            video="/videos/home/l3.mp4" rect={{ x: -32, y: 21.73, w: 950.438, h: 453.909 }}
          />
          <WorkCard
            title="eVTOL dashboard, desktop" meta="ORION • 2024"
            alt="ORION desktop dashboard: Good morning, Jane" poster={l4} w={886} h={553}
            video="/videos/home/l4.mp4" rect={{ x: -110, y: -54, w: 1105, h: 621 }}
          />
          <WorkCard
            title="Portfolio exploration" meta="Personal • Concept 2026"
            alt="Design Police Dept site with a red portrait" poster={l5} w={888} h={499.5}
            video="/videos/home/l5.mp4" rect={{ x: -13, y: -47, w: 914.59, h: 594 }} clip={{ x: 1, y: 1, w: 886, h: 497.5 }}
          />
          <!-- Figma 755:24556 (931 x 1329), shown whole on its white ground in a 16:10 card. -->
          <WorkCard
            title="Prosthetic Hand Research Project" meta="Non Zero • Medtech"
            alt="A prosthetic arm with a slim smart band on the wrist showing 55% charged" w={888} h={555} bg="#fffffd" border
          >
            <span slot="overlay" class="ov arm" style="--x:250.3;--y:1;--w:387.4;--h:553">
              <Image src={l7} alt="" width={388} densities={[1, 2]} format="webp" quality={90} loading="lazy" />
            </span>
          </WorkCard>
          <WorkCard
            title="Platform design and UX" meta="Reborn Goods • 2026"
            alt="We find the right people to build your brand: a platform home page" poster={l6} w={888} h={555}
            video="/videos/home/l6.mp4" rect={{ x: 0, y: -0.27, w: 896, h: 563 }} clip={{ x: 1, y: 1, w: 886, h: 553 }}
          />
        </div>
        <div class="col col-r" data-stagger>
          <WorkCard title="Google Maps study" meta="Personal • Study 2026" popup={MAPS_POPUP} alt="A map-pin logo filled with a flowing rainbow gradient" w={886} h={553} bg="#fafcfd">
            <span slot="overlay" class="ov pin-bg" style="--x:-8.86;--y:-5.53;--w:903.72;--h:564.06"></span>
            <span slot="overlay" class="ov pin" style={`--x:324;--y:157;--w:239;--h:239;--mask:url(${pinMask.src})`}>
              <span class="pin-flow"></span>
            </span>
          </WorkCard>
          <WorkCard
            title="Yucatan UI/UX & CGI website" meta="Non Zero • 2023" popup={YUCATAN_POPUP}
            alt="The Yucatan website on a laptop: a shirt and trousers to configure" poster={r2} w={888} h={621.59}
            video="/videos/home/r2.mp4" rect={{ x: -59, y: 39.23, w: 1007, h: 544 }} clip={{ x: 1, y: 1, w: 886, h: 619.59 }}
          />
          <WorkCard
            title="Titan 4 microwave oven, with the China team" meta="Whirlpool • 2023"
            alt="A microwave control panel: Enter cup, 00:02" poster={r3} w={888} h={621.59}
            video="/videos/home/r3.mp4" rect={{ x: 221, y: 59, w: 445, h: 641, r: 48 }} clip={{ x: 1, y: 1, w: 886, h: 619.59 }}
          />
          <WorkCard
            title="Identity Labs" meta="Agency website • 2026"
            alt="A hero over soft clouds: world's first content science lab" poster={r4} w={888} h={499.5}
            video="/videos/home/r4.mp4" rect={{ x: -20.64, y: -66.95, w: 913.286, h: 634 }} clip={{ x: 1, y: 1, w: 886, h: 497.5 }}
          />
          <WorkCard title="Vetted badge" meta="Reborn Goods • 2026" alt="A bronze Reborn Goods Vetted coin turning" w={888} h={555} bg="#958073" border>
            <img slot="overlay" class="ov ring" style="--x:251;--y:85.22;--w:385;--h:385" src="/videos/home/r5-ring.webp" alt="" loading="lazy" decoding="async" />
          </WorkCard>
          <!-- Figma 755:24578: an ambient recording (Luminosity blend, baked into hand.mp4) behind two phones. -->
          <WorkCard
            title="Prosthetic Hand Research Project" meta="Non Zero • Medtech"
            alt="Bio Arm Pro app: the grip gallery and the arm's home screen on two phones" poster={r7} w={903.72} h={631.99}
            video="/videos/home/hand.mp4" rect={{ x: 97, y: -222, w: 649, h: 1077 }} rotate={90}
          >
            <span slot="overlay" class="ov hand-phone" style="--x:466;--y:-164;--w:458;--h:959">
              <Image src={r7Phone} alt="" width={384} densities={[1, 2]} format="webp" quality={90} loading="lazy" />
            </span>
            <span slot="overlay" class="ov hand-grips" style="--x:105;--y:120;--w:347.059;--h:726">
              <Image src={r7Grips} alt="" width={402} densities={[1, 2]} format="webp" quality={90} loading="lazy" />
            </span>
          </WorkCard>
          <WorkCard
            title="Identity Labs" meta="Agency website • 2026"
            alt="Identity Labs: the science of viral posts" poster={r6} w={888} h={499.5}
            video="/videos/home/r6.mp4" rect={{ x: -24, y: -27, w: 936, h: 597 }} clip={{ x: 1, y: 1, w: 886, h: 497.5 }}
          />
        </div>
      </div>
    </section>

    <!-- Phones only: the project timeline moves below the work so the case studies come first. -->
    <section class="block tl-mobile" aria-labelledby="h-projects">
      <h2 class="tl-label" id="h-projects">Projects</h2>
      <ol class="timeline" data-stagger>
        {timeline.map(([year, name, desc]) => (
          <li class="row">
            <span class="row-year">{year}</span>
            <span class="row-name">{name}</span>
            <span class="row-desc">{desc}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- In the arsenal (633:9193 + 674:18567) -->
    <section class="block" aria-labelledby="h-arsenal">
      <h2 class="h-sec h-more" id="h-arsenal" data-split>In the arsenal...</h2>
      <div class="arsenal">
        <div class="ars-intro" data-reveal>
          <Mascot />
          <p class="ars-text">The tools, habits and instincts I bring to every team, from first framing to shipped screen.</p>
        </div>
        <ol class="skills" data-stagger>
          {skills.map(([name, tag], i) => (
            <li class="skill">
              <span class="skill-label">
                <span class="skill-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="skill-name">{name}</span>
              </span>
              <span class="skill-tag">{tag}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <Footer wide />

  <DeckDialog />
</Base>

<style>
  /* ---------- Page column ---------- */
  .home {
    max-width: calc(1200px + 120px);
    margin: 0 auto;
    padding: 24px 60px 0;
  }


  /* ---------- Intro ---------- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 24px;
    align-items: start;
    min-height: 982.795px;
    padding-top: 310.795px;
  }
  .intro-left { display: flex; flex-direction: column; gap: 24px; }
  .intro-lede {
    max-width: 559px;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 44px;
    letter-spacing: -1.6px;
    color: #1e2b3a;
  }
  .intro-details { display: flex; flex-direction: column; gap: 28px; margin: 0; padding-top: 20px; }
  .intro-details div { display: flex; flex-direction: column; gap: 8px; }
  .intro-details dt {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    text-transform: uppercase;
    color: rgba(50, 64, 79, 0.5);
  }
  .intro-details dd {
    max-width: 640px;
    margin: 0;
    font-size: 17px;
    line-height: 25.5px;
    letter-spacing: -0.34px;
    color: rgba(50, 64, 79, 0.8);
  }
  .intro-details dd.dd-strong { color: #32404f; }
  .timeline { display: flex; flex-direction: column; gap: 4px; }
  .tl-mobile { display: none; }
  .tl-label {
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
    line-height: 20px;
    text-transform: uppercase;
    color: rgba(50, 64, 79, 0.5);
  }
  /* On the 1200px column the timeline has ~588px, so rows wrap rather than run on one line. */
  .row {
    display: grid;
    grid-template-columns: 64px minmax(120px, 0.9fr) 1.6fr;
    column-gap: 8px;
    min-height: 24px;
    font-size: 15px;
    line-height: 22.5px;
  }
  .row-year {
    margin-top: -0.75px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: rgba(50, 64, 79, 0.58);
  }
  .row-name { color: var(--ink); }
  .row-desc { margin-top: -0.75px; color: rgba(50, 64, 79, 0.58); }

  .block { scroll-margin-top: 40px; }

  /* ---------- Section headings ---------- */
  .h-sec {
    max-width: 729px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: -1.6px;
    color: var(--ink);
  }
  /* "Detailed case studies": 23 top, 12.81 + 32 below */
  .h-case { padding: 23px 0 44.81px; }
  /* "More work..." / "In the arsenal...": sits 109px into a 177px block, 24 below */
  .h-more { padding: 109px 0 24px; }

  /* ---------- Card grids ---------- */
  .grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; align-items: start; }
  .col { display: flex; flex-direction: column; min-width: 0; }
  .grid-case .col-l { gap: 24px; padding-bottom: 66.59px; }
  .grid-case .col-r { gap: 32px; }
  .grid-more .col { gap: 24px; }

  /* Whirlpool logo over the cooktop video: Figma crop of a square image */
  .ov-logo { overflow: hidden; }
  .ov-logo :global(img) { position: absolute; left: 0; top: -98.37%; width: 100%; height: 292.31%; max-width: none; }

  /* Map-pin logo: a rainbow conic gradient turning inside the pin shape (Figma: 18s linear) */
  .pin-bg { background: rgba(235, 235, 235, 0.83); }
  .pin {
    overflow: hidden;
    -webkit-mask: var(--mask) 0 0 / 100% 100% no-repeat;
    mask: var(--mask) 0 0 / 100% 100% no-repeat;
  }
  .pin-flow {
    position: absolute;
    left: -50%;
    top: -60%;
    width: 200%;
    height: 200%;
    background: conic-gradient(from 90deg, rgb(40, 196, 121) 0%, rgb(44, 198, 121) 16.667%, rgb(71, 201, 111) 18.75%, rgb(97, 205, 100) 20.833%, rgb(150, 211, 78) 25%, rgb(202, 218, 57) 29.167%, rgb(255, 224, 36) 33.333%, rgb(255, 191, 52) 37.5%, rgb(255, 157, 67) 41.667%, rgb(255, 124, 83) 45.833%, rgb(255, 91, 99) 50%, rgb(228, 98, 136) 54.167%, rgb(200, 106, 173) 58.333%, rgb(173, 114, 209) 62.5%, rgb(145, 121, 246) 66.667%, rgb(112, 132, 251) 75%, rgb(80, 143, 255) 83.333%, rgb(60, 169, 188) 91.667%, rgb(50, 183, 155) 95.833%, rgb(40, 196, 121) 100%);
    animation: pin-turn 18s linear infinite;
  }
  @keyframes pin-turn { to { transform: rotate(1turn); } }
  .ring { object-fit: contain; }
  .arm :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .hand-phone :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: calc(50.355 * 100cqw / var(--W)); }
  .hand-grips { overflow: hidden; border-radius: calc(62.853 * 100cqw / var(--W)); }
  .hand-grips :global(img) { position: absolute; left: -2.62%; top: 0; width: 105.51%; height: 100.88%; max-width: none; }

  /* ---------- Arsenal ---------- */
  .arsenal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    align-items: start;
    padding: 40px 0 160px;
  }
  .ars-intro { display: flex; flex-direction: column; gap: 20px; }
  .ars-text {
    max-width: 420px;
    font-size: 17px;
    line-height: 25.5px;
    letter-spacing: -0.34px;
    color: rgba(50, 64, 79, 0.8);
  }
  .skill {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
  }
  .skill-label { display: flex; align-items: baseline; min-width: 0; }
  .skill-n {
    flex: 0 0 48px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: rgba(50, 64, 79, 0.45);
  }
  .skill-name {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 22px;
    letter-spacing: -0.8px;
    color: var(--ink);
    white-space: nowrap;
    transition: transform 0.45s var(--ease-out);
  }
  .skill:hover .skill-name { transform: translateX(6px); }
  .skill-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    text-transform: uppercase;
    color: rgba(50, 64, 79, 0.5);
    white-space: nowrap;
  }


  /* ---------- Smaller screens ---------- */
  @media (max-width: 1199px) {
    .intro { grid-template-columns: 1fr; min-height: 0; padding: 120px 0 96px; row-gap: 56px; }
  }
  @media (max-width: 959px) {
    .home { padding: 16px 24px 0; }
    .h-case { padding: 16px 0 32px; }
    .h-more { padding: 72px 0 24px; }
    .arsenal { grid-template-columns: 1fr; row-gap: 40px; padding-bottom: 120px; }
  }
  @media (max-width: 759px) {
    .tl-desk { display: none; }
    .tl-mobile { display: block; padding-top: 96px; }
    .grid { grid-template-columns: 1fr; }
    .grid .col { gap: 40px !important; padding-bottom: 0 !important; }
    .grid .col + .col { margin-top: 40px; }
    .intro { padding: 56px 0 64px; row-gap: 40px; }
    .intro-details dd { font-size: 16px; line-height: 24px; }
    .skill-name { white-space: normal; font-size: 19px; line-height: 23px; letter-spacing: -0.7px; }
    .skill-tag { display: none; }
  }
  @media (max-width: 600px) {
    .intro-lede { font-size: 32px; line-height: 36px; letter-spacing: -1.2px; }
    .home { padding: 8px 16px 0; }
    .row { grid-template-columns: 70px 1fr; row-gap: 0; padding-bottom: 6px; }
