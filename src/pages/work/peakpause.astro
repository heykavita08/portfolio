---
// PeakPause case study.
// Source: Figma "PeakPause, Case Study (Rachel structure)" — node 196:313.
// Spacing below mirrors the Figma spacer layers exactly; comments name the frame.
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Figure from '../../components/case-study/Figure.astro';
import SectionHead from '../../components/case-study/SectionHead.astro';
import CdscoLadder from '../../components/case-study/CdscoLadder.astro';
import VideoSlot from '../../components/case-study/VideoSlot.astro';

import heroPoster from '../../assets/peakpause/hero-poster.png';
import overview from '../../assets/peakpause/overview.png';
import problem from '../../assets/peakpause/problem.png';
import systemMap from '../../assets/peakpause/system-map.png';
import researchUsers from '../../assets/peakpause/research-users.png';
import researchExperts from '../../assets/peakpause/research-experts.png';
import researchReviews from '../../assets/peakpause/research-reviews.png';
import decision from '../../assets/peakpause/decision.png';
import competitive from '../../assets/peakpause/competitive.png';
import regulatoryMap from '../../assets/peakpause/regulatory-map.png';
import persona1 from '../../assets/peakpause/persona-1.png';
import persona2 from '../../assets/peakpause/persona-2.png';
import persona3 from '../../assets/peakpause/persona-3.png';
import legendDot from '../../assets/peakpause/legend-dot.svg';
import ia from '../../assets/peakpause/ia.png';
import test01 from '../../assets/peakpause/test-01-timeline.png';
import test02a from '../../assets/peakpause/test-02-a.png';
import test02b from '../../assets/peakpause/test-02-b.png';
import test03a from '../../assets/peakpause/test-03-a.png';
import test03b from '../../assets/peakpause/test-03-b.png';
import brandSystem from '../../assets/peakpause/brand-system.png';
import components from '../../assets/peakpause/components.png';
import timelineIterations from '../../assets/peakpause/timeline-iterations.png';
import chosenTimeline from '../../assets/peakpause/chosen-timeline.png';
import edgeCases from '../../assets/peakpause/edge-cases.png';
import flowOnboarding from '../../assets/peakpause/flow-onboarding.png';
import flowUpload from '../../assets/peakpause/flow-upload.png';
import flowTracking from '../../assets/peakpause/flow-tracking.png';
import flowManaging from '../../assets/peakpause/flow-managing.png';
import flowSharing from '../../assets/peakpause/flow-sharing.png';

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'problem', label: 'Problem' },
  { id: 'process', label: 'The process' },
  { id: 'research', label: 'Research' },
  { id: 'defining', label: 'Defining the product' },
  { id: 'timeline', label: 'The timeline' },
  { id: 'flows', label: 'Final flows' },
  { id: 'launch', label: 'Launch' },
  { id: 'reflection', label: 'Reflection' },
];

const meta = [
  { label: 'Role', value: ['Lead Designer'] },
  { label: 'Timeline', value: ['Mar – Dec 2025'] },
  { label: 'Team', value: ['3 Designers'] },
  { label: 'Skills', value: ['User Research', 'UX Architecture', 'UI Design', 'Prototyping'] },
];

// Figma "Process table" (198:1036). Row heights are fixed in Figma (uneven on purpose or not); kept as-is.
const process = [
  { n: '01', phase: 'Frame', did: 'Turned an open brief into research questions', decided: 'Learn the space before drawing anything', h: 83 },
  { n: '02', phase: 'Desk', did: 'PHR vs EHR, ABDM, regulation, competitors, user reviews', decided: 'Move to personal health records', h: 103 },
  { n: '03', phase: 'Regulate', did: 'Mapped where an app becomes a medical device', decided: 'Show records, never interpret them', h: 83 },
  { n: '04', phase: 'Users', did: 'Ecosystem map, stakeholder map, three personas', decided: 'Design for the family health manager', h: 90 },
  { n: '05', phase: 'Structure', did: 'User flow, information architecture, V1 split into phases', decided: 'What ships first', h: 83 },
  { n: '06', phase: 'Prototype', did: 'Quick ProtoPie tests, one feature at a time', decided: 'Keep or kill features early', h: 89 },
  { n: '07', phase: 'Timeline', did: 'Many iterations, tested internally and with recruited users', decided: 'One timeline direction', h: 101 },
  { n: '08', phase: 'Explore', did: 'UI directions far from existing health apps, then a brand system', decided: 'The visual language', h: 89 },
  { n: '09', phase: 'Edge cases', did: 'Every edge case worked through before final UI', decided: 'Fewer surprises in testing', h: 101 },
  { n: '10', phase: 'Launch', did: 'Investor video, website, sales decks', decided: 'First 12 users', h: 62 },
  { n: '11', phase: 'Phase 2', did: 'Designing from what those users told us', decided: 'In progress', future: true, h: 62 },
];

// Figma "Personas" (229:590). Portrait crops copied from the file.
const personas = [
  {
    name: 'The family health manager',
    primary: true,
    quote: '“I know I have this somewhere.”',
    summary: 'Caregiver juggling several people’s records.',
    img: persona1,
    tint: 0.32,
    crop: { left: 40, width: 136, radius: 56 },
    gap: 10,
    traits: [
      ['Age', '35–50'],
      ['Manages', 'Self, kids and parents'],
      ['Records in', 'WhatsApp, email, a drawer'],
      ['Tech', 'Everyday apps, not a power user'],
      ['Opens app', 'Before every family visit'],
    ],
  },
  {
    name: 'The chronic-condition tracker',
    quote: '“I should’ve been more prepared.”',
    summary: 'Monitoring markers like glucose or thyroid over years.',
    img: persona2,
    tint: 0.2,
    crop: { left: 21, width: 174, radius: 0 },
    gap: 10,
    traits: [
      ['Age', '40–55'],
      ['Manages', 'Their own condition'],
      ['Records in', 'Lab portals, paper files'],
      ['Tech', 'Comfortable, careful with data'],
      ['Opens app', 'After every test'],
    ],
  },
  {
    name: 'The occasional user',
    quote: '“I just wait for the doctor to tell me.”',
    summary: 'Annual check-ups.',
    img: persona3,
    tint: 0.2,
    crop: { left: 30, width: 156, radius: 0 },
    gap: 14,
    traits: [
      ['Age', '28–40'],
      ['Manages', 'Just themselves'],
      ['Records in', 'Email inbox'],
      ['Tech', 'High'],
      ['Opens app', 'Once or twice a year'],
    ],
  },
];

const flows = [
  {
    img: flowOnboarding,
    video: '/videos/peakpause/flow-onboarding.mp4',
    title: 'Set up in minutes, with consent up front',
    body: 'Account, consent under the DPDP Act and family profiles, then eight quick tips that show where everything lives.',
  },
  {
    img: flowUpload,
    video: '/videos/peakpause/upload.mp4',
    title: 'Upload once, filed under the right person',
    body: 'Pick a file or snap a photo. If a report looks like it belongs to someone else, the app asks before filing it.',
  },
  {
    img: flowTracking,
    video: '/videos/peakpause/flow-tracking.mp4',
    title: 'Track every report over time',
    body: 'Each report lands on one timeline, and every biomarker sits against your own past values.',
  },
  {
    img: flowManaging,
    video: '/videos/peakpause/flow-managing.mp4',
    title: 'Keep each family member’s records apart',
    body: 'A profile for everyone, with reports, prescriptions and insurance sorted in one place.',
  },
  {
    img: flowSharing,
    video: '/videos/peakpause/flow-sharing.mp4',
    title: 'Share the right records, fast',
    body: 'Bundle reports by folder or by date into one file, ready to send to the doctor.',
  },
];

const LOOM_ID = 'f5633e5bebca4ceb8dbef5992e973c92';
const SITE_URL = 'https://peakpause.com/';
---
<CaseStudy
  title="PeakPause — Kavita Tewari"
  description="A calm home for a family’s health records. PeakPause case study by Kavita Tewari, Lead Designer."
  sections={sections}
>
  <!-- Header (196:335) -->
  <header class="header">
    <p class="t-label">PeakPause • Launched 2025</p>
    <h1 class="t-display header-title" data-split>A calm home for a family’s health records</h1>
    <VideoSlot
      class="mt-40"
      poster={heroPoster}
      alt="PeakPause launch video"
      src="/videos/peakpause/hero.mp4"
      mode="click"
      width={704}
      height={403}
      rect={{ x: 142, y: 0, w: 420, h: 403 }}
      caption="Launch video for PeakPause"
      mobileRatio="4/3"
    />
  </header>

  <!-- Meta (196:342) -->
  <dl class="meta" data-stagger>
    {meta.map((m) => (
      <div class="meta-col">
        <dt>{m.label}</dt>
        <dd>{m.value.map((v) => <span>{v}</span>)}</dd>
      </div>
    ))}
  </dl>

  <!-- Overview (196:355) -->
  <section id="overview" class="sec">
    <SectionHead
      label="Overview"
      title="PeakPause is a health records app for the person who manages everyone’s health."
      lead="It was Non Zero’s first medtech product. No client, no feature list, just a question: could a design studio build something meaningful in healthcare?"
    />
    <VideoSlot
      class="mt-24"
      poster={overview}
      alt="PeakPause home screen on a phone, over an orange gradient"
      src="/videos/peakpause/upload.mp4"
      width={704}
      height={396}
      rect={{ x: 278, y: 43, w: 148, h: 310, r: 28 }}
      caption="PeakPause V1, the core experience"
      mobileRatio="1/1"
    />
  </section>

  <!-- Problem (202:313) -->
  <section id="problem" class="sec">
    <SectionHead
      label="Problem"
      title="Health records exist. They just can’t be found when they matter."
      lead="The person managing a family’s health has no single place for everyone’s records. Reports sit in WhatsApp, drawers and email, so at a doctor’s visit or a parent’s emergency they can’t find what they need, and walk in unprepared."
    />
    <Figure
      class="mt-24"
      src={problem}
      alt="A person dwarfed by a giant lab report"
      width={704}
      height={396}
    mobileRatio="4/3"
    />
    <p class="t-title hmw mt-64" data-split>How might we help them find any record in seconds, without the app ever playing doctor?</p>
  </section>

  <!-- The process (200:313) -->
  <section id="process" class="sec">
    <p class="t-label">The process</p>
    <table class="process mt-12">
      <thead data-reveal>
        <tr>
          <th scope="col">#</th>
          <th scope="col">Phase</th>
          <th scope="col">What we did</th>
          <th scope="col">What it decided</th>
        </tr>
      </thead>
      <tbody data-stagger>
        {process.map((r) => (
          <tr class:list={{ future: r.future }} style={r.h ? `--h:${r.h}px` : undefined}>
            <td class="p-n">{r.n}</td>
            <th scope="row" class="p-phase">{r.phase}</th>
            <td class="p-did">{r.did}</td>
            <td class="p-decided">{r.decided}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- Research (198:1141) -->
  <section id="research" class="sec sec-research">
    <p class="t-label">Research</p>
    <h2 class="t-title research-title mt-12" data-split>We spent months in research before drawing a single screen.</h2>

    <h3 class="t-sub">We mapped the whole system.</h3>
    <p class="t-body mt-13">Who creates health data, who owns it, who regulates it, and how ABDM connects them.</p>
    <Figure
      class="mt-13"
      src={systemMap}
      alt="Diagram: who touches a health record across care, payment and rules, and where PeakPause sits"
      width={704}
      height={1369}
    zoom
    />

    <h3 class="t-sub mt-64">Talked to target users</h3>
    <p class="t-body mt-13">Who creates health data, who owns it, who regulates it, and how ABDM connects them.</p>
    <Figure class="mt-13" src={researchUsers} alt="Video calls with target users" width={704} height={396} zoom />

    <h3 class="t-sub">Talked to doctors and professionals and lab guys who interact with each other on daily basis</h3>
    <p class="t-body mt-13">Who creates health data, who owns it, who regulates it, and how ABDM connects them.</p>
    <Figure class="mt-13" src={researchExperts} alt="Video calls with doctors, professionals and lab staff" width={704} height={396} zoom />

    <h3 class="t-sub mt-64">And read what people already complain about.</h3>
    <p class="t-body mt-8">User reviews, forum threads, and every competitor we could find.</p>
    <Figure class="mt-24" src={researchReviews} alt="Collage of user reviews and forum threads about health records" width={704} height={396} zoom />

    <p class="t-body mt-64">If an app interprets results or suggests treatment, CDSCO treats it as Software as a Medical Device (SaMD), using the global IMDRF definition India follows. The more it interprets, the higher the risk class and the longer the licence takes.</p>
    <CdscoLadder class="mt-24" />
    <div class="decision mt-20">
      <Image
        src={decision}
        alt="So for MVP we set one rule early: PeakPause shows what the lab said, in plain words, against your own history. It never diagnoses."
        width={696}
        height={113}
        densities={[1, 2]}
        format="webp"
        quality={95}
        loading="lazy"
        class="decision-img"
      />
      <p class="decision-text" data-split>So for MVP we set one rule early: PeakPause shows what the lab said, in plain words, against your own history. It never diagnoses.</p>
    </div>
    <Figure
      class="mt-64"
      src={competitive}
      alt="Competitive landscape: direct competitors, partial overlaps and related ecosystems around PeakPause"
      width={704}
      height={832}
    zoom
    />
    <VideoSlot
      poster={regulatoryMap}
      alt="Regulatory map and India checklist for the app"
      src="/videos/peakpause/regulatory-map.mp4"
      width={704}
      height={396}
      rect={{ x: -9, y: -18.5, w: 722, h: 433 }}
    />
  </section>

  <!-- Defining the product (196:444) -->
  <section id="defining" class="sec">
    <SectionHead
      label="Defining the product"
      title="Who it’s for, and the one thing V1 had to do well."
      lead="Adults in their 30s to 50s, often handling records for parents and children too. Not patients in crisis."
    />

    <div class="personas mt-24" data-stagger>
      {personas.map((p) => (
        <article class="persona" style={`--gap:${p.gap}px`}>
          <div class="portrait" style={`--tint:${p.tint}`}>
            <Image
              src={p.img}
              alt=""
              width={p.crop.width}
              densities={[1, 2]}
              format="webp"
              quality={90}
              loading="lazy"
              style={`left:${p.crop.left}px;width:${p.crop.width}px;border-radius:${p.crop.radius}px`}
            />
          </div>
          <div class="persona-tag">
            {p.primary && <span class="tag tag-md">Primary user</span>}
          </div>
          <h3 class="persona-name">{p.name}</h3>
          <p class="persona-quote">{p.quote}</p>
          <p class="t-body">{p.summary}</p>
          <dl class="traits">
            {p.traits.map(([k, v]) => (
              <div class="trait">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <div class="ia-head mt-64">
      <h3 class="t-sub">Information architecture</h3>
      <div class="legend" aria-hidden="true">
        <span class="legend-item"><img src={legendDot.src} width="6" height="6" alt="" />Key screen</span>
        <span class="legend-item"><i class="legend-swatch"></i>Flow</span>
      </div>
    </div>
    <Figure
      src={ia}
      alt="Information architecture: onboarding and login lead to the home dashboard, which branches into upload, files, timeline, family & settings, and your data"
      width={704}
      height={573}
    zoom
    />

    <h3 class="t-sub mt-64">Small tests, one feature at a time.</h3>
    <p class="t-body mt-8">Instead of testing once at the end, we put quick ProtoPie prototypes of single features in front of people early. Weak ideas died in days, not sprints.</p>

    <!-- Test 01 (239:590) -->
    <div class="test-pair mt-24">
      <div class="test-text">
        <p class="t-label-sm">Test 01 · Timeline</p>
        <h4 class="test-title mt-8">Find February’s reports from the timeline</h4>
        <p class="t-small mt-8">Timeline → tap a card → files page → filter to February → sort by week</p>
        <p class="result mt-16"><strong>What changed:</strong> Cards and the timeline got real tap targets, plus a “View all”.</p>
      </div>
      <Figure src={test01} alt="Timeline test screens" width={420} height={451} zoom />
    </div>

    <!-- Test 02 (239:602) -->
    <div class="mt-56">
      <p class="t-label-sm">Test 02 · Search</p>
      <h4 class="test-title mt-8">Search for a file, two ways</h4>
      <p class="t-small mt-8">Search → files page with history and filters → pick a suggestion → the file, under Reports</p>
      <div class="routes mt-16">
        <figure class="route">
          <Image src={test02a} alt="Route A: search bar at the top" width={342} height={366} densities={[1, 2]} format="webp" quality={90} loading="lazy" style="aspect-ratio:342/366;object-fit:cover" data-zoom />
          <figcaption class="route-cap">
            <span class="cap-text" style="width:282px">A · Search bar at the top</span>
            <span class="tag tag-sm">Kept</span>
          </figcaption>
        </figure>
        <figure class="route">
          <Image src={test02b} alt="Route B: search in the bottom nav" width={342} height={366} densities={[1, 2]} format="webp" quality={90} loading="lazy" style="aspect-ratio:342/366;object-fit:cover" data-zoom />
          <figcaption class="route-cap">
            <span class="cap-text">B · Search in the bottom nav</span>
          </figcaption>
        </figure>
      </div>
      <p class="result mt-16"><strong>Result:</strong> People looked for search at the top first. Moving it there cut the task from 2:38 to 1:20.</p>
    </div>

    <!-- Test 03 (239:623) -->
    <div class="mt-56">
      <p class="t-label-sm">Test 03 · Upload</p>
      <h4 class="test-title mt-8">Upload a report from a busy home screen</h4>
      <p class="t-small mt-8">Upload → choose a file → uploading → confirm → different profile detected → switch profile → filed under the right person. Side path: edit the name or date, then back to confirm.</p>
      <figure class="mt-16">
        <Image src={test03a} alt="Route A: upload button at the top" width={704} height={286} densities={[1, 2]} format="webp" quality={90} loading="lazy" style="aspect-ratio:704/286;object-fit:cover" data-zoom />
        <figcaption class="route-cap mt-8"><span class="cap-text">A · Upload button at the top</span></figcaption>
      </figure>
      <figure class="mt-20">
        <Image src={test03b} alt="Route B: upload in the bottom nav" width={704} height={303} densities={[1, 2]} format="webp" quality={90} loading="lazy" style="aspect-ratio:704/303;object-fit:cover" data-zoom />
        <figcaption class="route-cap mt-8">
          <span class="cap-text" style="width:644px">B · Upload in the bottom nav</span>
          <span class="tag tag-sm">Kept</span>
        </figcaption>
      </figure>
      <p class="result mt-16"><strong>Result:</strong> Upload became a permanent button in the bottom nav, and the different-profile step became the three message tiers.</p>
    </div>
  </section>

  <!-- Visual direction — first part of Figma frame "The timeline" (196:485) -->
  <section class="sec sec-tail">
    <h3 class="t-sub">We explored far from existing health apps.</h3>
    <p class="t-body">Several UI directions before settling. The one we chose became the brand system.</p>
    <Figure src={brandSystem} alt="Brand system: Source Serif 4 and DM Sans, with neutral, primary and secondary colour ramps" width={704} height={480} zoom />
    <Figure class="mt-20" src={components} alt="Components: buttons, inputs, OTP and upload states, timeline and health graph cards, tabs, search and file lists" width={704} height={840} zoom />
  </section>

  <!-- The timeline (196:486 onward) -->
  <section id="timeline" class="sec" style="--pt:94px">
    <SectionHead
      label="The timeline"
      title="The timeline is the product, so it got the most iterations."
      lead="We explored many versions, tested them internally, then with users we recruited, and only then picked one to take forward."
    />
    <VideoSlot
      class="mt-24"
      poster={timelineIterations}
      alt="Timeline iterations"
      src="/videos/peakpause/timeline-iterations.mp4"
      width={704}
      height={460}
      rect={{ x: 257, y: 36, w: 191, h: 397, r: 29 }}
      mobileRatio="1/1"
    />
    <Figure
      class="mt-24"
      src={chosenTimeline}
      alt="The chosen timeline direction on a phone"
      width={704}
      height={396}
      caption="The timeline direction we chose"
    mobileRatio="1/1"
    />

    <h3 class="t-sub mt-136">Every edge case, before the final UI.</h3>
    <p class="t-body mt-8">Whose report is this? What if it has two names on it? When the app guesses, it asks. It never decides for you.</p>
    <Figure
      class="mt-24"
      src={edgeCases}
      alt="Profile detection: when an upload seems to belong to a different family member, three message types nudge you to verify, without blocking you"
      width={704}
      height={341.5}
    zoom
    />
  </section>

  <!-- Final flows (269:755) -->
  <section id="flows" class="sec">
    <SectionHead label="Final flows" title="From first open to everyday use." />
    <div class="flows" data-stagger>
      {flows.map((f) => (
        <div class="flow">
          <VideoSlot class="flow-media" poster={f.img} alt="" src={f.video} width={300} height={611} rect={{ x: 0, y: 0, w: 300, h: 611 }} />
          <div class="flow-text">
            <h3 class="flow-title">{f.title}</h3>
            <p class="t-body">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Launch (196:533) -->
  <section id="launch" class="sec">
    <SectionHead
      label="Launch"
      title="Then we made it real."
      lead="A short video for investors, a website I designed and built, and sales decks. Then our first 12 users. Phase 2 is being designed with them now, and is under wraps."
    />
    <div class="pair mt-24">
      <div class="pair-text">
        <h3 class="t-sub">Investor video</h3>
        <p class="t-body">A short walkthrough for the first investor conversations.</p>
      </div>
      <div class="embed">
        <iframe
          src={`https://www.loom.com/embed/${LOOM_ID}?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true`}
          title="PeakPause investor video"
          loading="lazy"
          allow="fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>
    <div class="pair mt-24">
      <div class="pair-text">
        <h3 class="t-sub">peakpause.com</h3>
        <p class="t-body">Designed and built by me, for sign-ups and early sales on framer.</p>
      </div>
      <a class="embed site" href={SITE_URL} target="_blank" rel="noopener" aria-label="Open peakpause.com in a new tab">
        <iframe src={SITE_URL} title="peakpause.com preview" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
      </a>
    </div>
  </section>

  <!-- Reflection (196:556) -->
  <section id="reflection" class="sec">
    <SectionHead label="Reflection" title="If I ever ran it again" />
    <div class="reflections" data-stagger>
      <div>
        <h3 class="t-sub">The research decided more than any screen did.</h3>
        <p class="t-body mt-8">The pivot and the licensing line were both research calls, made months before the UI.</p>
      </div>
      <div>
        <h3 class="t-sub">Design for the return visit.</h3>
        <p class="t-body mt-8">People add a record once and come back many times to find it. I’d design the home for that from day one.</p>
      </div>
      <div>
        <h3 class="t-sub">Give onboarding real time up front.</h3>
        <p class="t-body mt-8">We treated it as a late step, and testing showed it.</p>
      </div>
    </div>
  </section>
</CaseStudy>

<script>
  // Scale the live peakpause.com preview (rendered at 1280px) down to its box.
  const site = document.querySelector<HTMLElement>('.embed.site');
  if (site) {
    const fit = () => site.style.setProperty('--scale', String(site.clientWidth / 1280));
    new ResizeObserver(fit).observe(site);
    fit();
  }
</script>

<style>
  /* Sections: 120px top padding; anchor jumps land the label level with the sidebar. */
  .sec {
    --pt: 120px;
    padding-top: var(--pt);
